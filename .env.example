# All optional. Copy to .env (gitignored) or set in your shell / service manager.
# TG_DATA=./backend/data          # SQLite db + generated device key
# TG_PORT=8940                    # port when started with `python server.py`
# TG_BARS_DIR=./backend/data/bars # NQ_1m.parquet / ES_1m.parquet for the optional bars endpoint
# Journal bridge (only if you run a trade journal next to TiltGuard):
# JOURNAL_URL=http://127.0.0.1:8950
# JOURNAL_PASSWORD=               # the journal's login; also becomes TiltGuard's web login
